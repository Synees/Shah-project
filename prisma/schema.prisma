// Shah Project - schema final
// Catatan: jika Prisma yang terpasang v7+, konfigurasi koneksi (DATABASE_URL pooled & DIRECT_URL)
// dipindah ke prisma.config.ts. Blok enum dan model di bawah tetap sama.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductCategory {
  MAHAR
  SESERAHAN
}

enum DeliveryMethod {
  AMBIL_SENDIRI
  DIANTAR
}

enum OrderStatus {
  MENUNGGU_KONFIRMASI
  DITOLAK
  MENUNGGU_PEMBAYARAN
  MENUNGGU_VERIFIKASI_PEMBAYARAN
  DIPROSES
  SELESAI
  DIBATALKAN
  KEDALUWARSA
}

enum PaymentVerificationStatus {
  MENUNGGU_VERIFIKASI
  TERVERIFIKASI
  DITOLAK
}

enum CancelledBy {
  CUSTOMER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  whatsapp     String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BoxType {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  totalQuota  Int         @default(10)
  products    Product[]
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Product {
  id          String          @id @default(cuid())
  name        String
  category    ProductCategory
  boxTypeId   String?
  boxType     BoxType?        @relation(fields: [boxTypeId], references: [id], onDelete: SetNull)
  price       Int
  description String          @db.Text
  imageUrl    String
  isActive    Boolean         @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category, isActive])
}

model Order {
  id              String         @id @default(cuid())
  orderCode       String         @unique // contoh: SHP-20261124-A7K2 (sufiks acak)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  eventDate       DateTime       @db.Date
  deliveryMethod  DeliveryMethod
  deliveryAddress String?        @db.Text
  customNotes     String?        @db.Text
  subtotal        Int
  shippingCost    Int            @default(0)
  totalAmount     Int
  status          OrderStatus    @default(MENUNGGU_KONFIRMASI)

  // Persetujuan owner
  rejectionReason String?        @db.Text
  paymentDeadline DateTime?

  // Pembatalan
  cancelledAt                 DateTime?
  cancelledBy                 CancelledBy?
  cancelReason                String?   @db.Text
  cancelRequestedAt           DateTime? // diisi customer saat status DIPROSES; kosongkan jika ditolak admin
  cancelRequestReason         String?   @db.Text
  cancelRequestRejectionNote  String?   @db.Text

  // Refund manual (admin transfer sendiri, lalu tandai di sini)
  refundedAt DateTime?
  refundNote String?   @db.Text

  finalReportImageUrl String?
  itemsReceivedAt     DateTime? // barang seserahan dari pelanggan diterima
  handedOverAt        DateTime? // pesanan diambil / diantar ke pelanggan
  items               OrderItem[]
  payments            Payment[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([eventDate, status])
  @@index([userId, createdAt])
  @@index([status, paymentDeadline])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  boxTypeId String? // diturunkan dari Product di SERVER, bukan dari input klien
  boxType   BoxType? @relation(fields: [boxTypeId], references: [id], onDelete: Restrict)
  quantity  Int      @default(1)
  unitPrice Int
  subtotal  Int

  @@index([boxTypeId])
}

// Pembayaran tunggal 100% per pesanan. Bisa lebih dari satu baris karena
// bukti yang ditolak dapat diunggah ulang.
model Payment {
  id            String                    @id @default(cuid())
  orderId       String
  order         Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Int // wajib sama dengan Order.totalAmount (divalidasi di server)
  proofUrl      String
  status        PaymentVerificationStatus @default(MENUNGGU_VERIFIKASI)
  rejectionNote String?                   @db.Text
  verifiedAt    DateTime?
  createdAt     DateTime                  @default(now())

  @@index([orderId, status])
}
